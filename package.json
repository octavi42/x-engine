{
  "name": "x-engine",
  "version": "1.0.0",
  "description": "Personal X/Twitter content engine powered by Claude Code scheduled tasks.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "post": "node --env-file=.env.local scripts/post.mjs",
    "post:dry": "node --env-file=.env.local scripts/post.mjs --dry",
    "check-auth": "node --env-file=.env.local scripts/check-auth.mjs",
    "post:ci": "node scripts/post.mjs",
    "notify": "node scripts/notify.mjs",
    "sync": "node --env-file=.env.local scripts/sync-sources.mjs",
    "enhance": "node --env-file=.env.local scripts/enhance.mjs",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octavi42/x-engine.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/octavi42/x-engine/issues"
  },
  "homepage": "https://github.com/octavi42/x-engine#readme",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "fast-xml-parser": "^5.7.2",
    "twitter-api-v2": "^1.29.0"
  }
}
