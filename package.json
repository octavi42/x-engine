{
  "name": "x-engine",
  "version": "1.0.0",
  "description": "Personal X/Twitter content engine powered by Claude Code scheduled tasks.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "post": "node --env-file=.env.local scripts/post.mjs",
    "post:dry": "node --env-file=.env.local scripts/post.mjs --dry",
    "check-auth": "node --env-file=.env.local scripts/check-auth.mjs",
    "post:ci": "node scripts/post.mjs",
    "notify": "node scripts/notify.mjs",
    "sync": "node --env-file=.env.local scripts/sync-sources.mjs",
    "sync:ci": "node scripts/sync-sources.mjs",
    "draft": "node --env-file=.env.local scripts/draft.mjs",
    "draft:ci": "node scripts/draft.mjs",
    "enhance": "node --env-file=.env.local scripts/enhance.mjs",
    "enhance:ci": "node scripts/enhance.mjs",
    "feedback": "node --env-file=.env.local scripts/feedback.mjs",
    "feedback:dry": "node --env-file=.env.local scripts/feedback.mjs --dry",
    "feedback:ci": "node scripts/feedback.mjs",
    "hunt": "node --env-file=.env.local scripts/hunt.mjs",
    "hunt:dry": "node --env-file=.env.local scripts/hunt.mjs --dry",
    "hunt:ci": "node scripts/hunt.mjs",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octavi42/x-engine.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/octavi42/x-engine/issues"
  },
  "homepage": "https://github.com/octavi42/x-engine#readme",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.7.2",
    "twitter-api-v2": "^1.29.0",
    "zod": "^4.4.3"
  }
}
