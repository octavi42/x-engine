# X (Twitter) API — OAuth 1.0a User Context
# Generate at developer.x.com -> Project -> App -> Keys and tokens.
# App must have Read AND Write permissions before regenerating tokens.

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Anthropic — required by `npm run sync` (peer-posts research agent) and `npm run enhance`.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Override the default models if you want (sonnet 4.6 by default for both).
# RESEARCH_MODEL=claude-opus-4-7
# IMPROVE_MODEL=claude-sonnet-4-6

# twitterapi.io — required by the peer-posts source.
# Sign up at https://twitterapi.io/ — pay-as-you-go, ~$0.15 / 1k tweets.
TWITTERAPI_IO_KEY=
