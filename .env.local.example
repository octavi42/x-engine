# X (Twitter) API — OAuth 1.0a User Context
# Generate at developer.x.com -> Project -> App -> Keys and tokens.
# App must have Read AND Write permissions before regenerating tokens.

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# twitterapi.io — required by the peer-posts source AND the engagement
# feedback loop (`npm run feedback`).
# Sign up at https://twitterapi.io/ — pay-as-you-go, ~$0.15 / 1k tweets.
TWITTERAPI_IO_KEY=

# Claude Code OAuth token — required by `npm run sync` (peer-posts research
# agent) and `npm run enhance`. Both scripts run `claude -p` headless mode
# and bill against your Pro/Max subscription.
#
# Generate (one-time, expires after ~1 year):
#   claude setup-token
# Then paste the token below.
#
# CRITICAL: do NOT also set ANTHROPIC_API_KEY. If both are present the CLI
# silently bills the API key and you can rack up unexpected per-token charges
# (search GitHub claude-code#37686). The scripts pre-flight-check this and
# refuse to run if ANTHROPIC_API_KEY is set.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional model overrides (sonnet 4.6 by default for both).
# RESEARCH_MODEL=claude-opus-4-7
# IMPROVE_MODEL=claude-sonnet-4-6
